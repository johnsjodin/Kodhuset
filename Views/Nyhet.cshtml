@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@{
    Layout = "master.cshtml";
    var bild = Model.Value<MediaWithCrops>("bild");
}

<article>
    <h1>@Model.Name</h1>
    <p class="datum">Publicerad @Model.CreateDate.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))</p>
    <p class="ingress">@Model.Value("ingress")</p>

    @if (bild != null)
    {
        <img class="huvudbild" src="@bild.GetCropUrl(width: 1200)" alt="@bild.Name" />
    }

    @Model.Value("brodtext")
</article>
