@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@{
    Layout = null;
    var bild = Model.Value<MediaWithCrops>("bild");
}
<!doctype html>
<html lang="sv">
<head><meta charset="utf-8"><title>@Model.Name</title><link rel="stylesheet" href="/css/site.css"></head>
<body>
  <h1>@Model.Name</h1>
  <h2><em>@Model.Value("ingress")</em></h2>

  @if (bild != null)
  {
      <img src="@bild.Url()" alt="@bild.Name" />
  }

  @Model.Value("brodtext")
</body>
</html>